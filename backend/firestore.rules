rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Public review page: reviewers may add one feedback entry at a time.
    // Nobody can read, change or delete entries from the page.
    match /feedback/{id} {
      allow create: if
        request.resource.data.keys().hasOnly(['kind','chapter','product','option','version','text','name','org','email','clientTime','row','verdict','note'])
        && request.resource.data.keys().hasAll(['kind','chapter','product','option','name','org','email'])
        && request.resource.data.kind in ['vote','comment','proof']
        && request.resource.data.chapter in ['ch1','ch2','ch3','ch4','ch5','ch6']
        && request.resource.data.product in ['poster','leaflet','guide']
        && request.resource.data.option in ['A','B','C','all']
        && request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 120
        && request.resource.data.org is string && request.resource.data.org.size() > 0 && request.resource.data.org.size() <= 160
        && request.resource.data.email is string && request.resource.data.email.size() <= 200
        && request.resource.data.email.matches('.+@.+[.].+')
        && (!('version' in request.resource.data) || (request.resource.data.version is string && request.resource.data.version.size() <= 120))
        && (!('clientTime' in request.resource.data) || (request.resource.data.clientTime is string && request.resource.data.clientTime.size() <= 40))
        && (request.resource.data.kind != 'vote' || (request.resource.data.option in ['A','B','C'] && request.resource.data.product == 'poster' && !('text' in request.resource.data)))
        && (request.resource.data.kind != 'comment' || (request.resource.data.text is string && request.resource.data.text.size() > 0 && request.resource.data.text.size() <= 3000))
        && (request.resource.data.kind == 'proof' || (!('row' in request.resource.data) && !('verdict' in request.resource.data) && !('note' in request.resource.data)))
        // Proofreading: one check per text row (row ID as on the Translation tab); 'change' carries the corrected Nepali.
        && (request.resource.data.kind != 'proof' || (
              request.resource.data.option == 'all'
              && request.resource.data.row is string && request.resource.data.row.matches('^C[1-6][PLG]-[0-9]{2,3}$')
              && request.resource.data.verdict in ['ok','change']
              && (request.resource.data.verdict != 'ok' || !('text' in request.resource.data))
              && (request.resource.data.verdict != 'change' || (request.resource.data.text is string && request.resource.data.text.size() > 0 && request.resource.data.text.size() <= 3000))
              && (!('note' in request.resource.data) || (request.resource.data.note is string && request.resource.data.note.size() <= 1000))));
      allow read, update, delete: if false;
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
